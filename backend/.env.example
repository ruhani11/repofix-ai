# Fresh setup: copy this template to backend/.env only if .env does not exist.
# Keep real credentials in that private file. Restart the server after edits.

# Application settings
REPOFIX_APP_NAME=RepoFix AI
REPOFIX_ENVIRONMENT=development

# GitHub OAuth callback for local development
REPOFIX_GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/auth/github/callback

# Uncomment BOTH credential lines in your private .env and fill actual values.
# REPOFIX_GITHUB_CLIENT_ID=your_github_oauth_client_id
# REPOFIX_GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Gemini profile used for the current development trial.
# A model ID and key presence do not verify access, quota or free-tier eligibility.
REPOFIX_AI_PROVIDER=gemini
REPOFIX_AI_MODEL=gemini-3.6-flash
# Uncomment in private .env and replace the placeholder with your actual key.
# REPOFIX_GEMINI_API_KEY=your_gemini_api_key

# Optional OpenAI profile: replace the provider/model above together and set
# REPOFIX_AI_PROVIDER=openai
# REPOFIX_AI_MODEL=your_openai_model_id
# REPOFIX_OPENAI_API_KEY=your_openai_api_key
# The selected provider's key is used; there is no automatic paid fallback.

# Enforced workflow limits. Retries and their waits share the overall deadline.
REPOFIX_AI_MAX_TURNS=10
REPOFIX_AI_TIMEOUT_SECONDS=180
